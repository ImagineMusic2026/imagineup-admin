# Copie para .env.local (ignorado pelo git) e preencha com o app web do
# projeto imagine-up-app (Console do Firebase > Configurações do projeto >
# Seus apps). São valores públicos do SDK do cliente, mas ficam fora do git.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Opcional. Com um host (ex.: 127.0.0.1), o painel usa os emuladores do
# Firebase (Auth 9099, Firestore 8080, Functions 5001, Storage 9199) no projeto
# demo-imagine-up-app e ignora o projeto real. Deixe vazio fora dos testes.
NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=

# Opcionais. Portas dos emuladores, só quando outra sessão ocupa as padrões
# (9099, 8080, 5001 e 9199). Vazias, valem as padrões.
NEXT_PUBLIC_FIREBASE_EMULATOR_AUTH_PORT=
NEXT_PUBLIC_FIREBASE_EMULATOR_FIRESTORE_PORT=
NEXT_PUBLIC_FIREBASE_EMULATOR_FUNCTIONS_PORT=
NEXT_PUBLIC_FIREBASE_EMULATOR_STORAGE_PORT=
